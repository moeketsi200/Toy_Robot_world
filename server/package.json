{
  "name": "toy-robot-worlds-server",
  "version": "1.0.0",
  "description": "Authoritative Multiplayer WebSocket Server for Toy Robot Worlds",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
